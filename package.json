{
	"name": "@astralyn/search",
	"version": "0.2.0",
	"description": "MCP server for semantic code search and live web search, powered by Devin",
	"type": "module",
	"license": "MIT",
	"author": "Astralyn",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ming-kang/DevinSearch.git"
	},
	"keywords": [
		"mcp",
		"mcp-server",
		"code-search",
		"web-search",
		"devin"
	],
	"bin": {
		"search": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc -p tsconfig.build.json",
		"format": "biome check --write .",
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test": "vitest --run",
		"prepublishOnly": "npm run check && npm test && npm run build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.1",
		"zod": "3.25.76"
	},
	"optionalDependencies": {
		"@vscode/ripgrep": "1.18.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.20.5",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"publishConfig": {
		"access": "public"
	}
}
